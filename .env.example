# ─────────────────────────────────────────────────────────────────────────────
# Uttermost login (REQUIRED)
# The trade/customer account whose login unlocks overstock pricing.
# ─────────────────────────────────────────────────────────────────────────────
UTTERMOST_EMAIL=you@example.com
UTTERMOST_PASSWORD=your-password

# ─────────────────────────────────────────────────────────────────────────────
# Scrape targets & login flow (OPTIONAL — defaults are sensible)
# Override these only if the site's URLs or form markup change.
# ─────────────────────────────────────────────────────────────────────────────
UTTERMOST_OVERSTOCKS_URL=https://uttermost.com/promotions/overstocks
UTTERMOST_LOGIN_URL=https://uttermost.com/sign-in

# CSS selectors used during login. Defaults try the common Magento/Venia markup.
# If login fails, run with ?debug=1 to get a screenshot, then tune these.
UTTERMOST_EMAIL_SELECTOR=
UTTERMOST_PASSWORD_SELECTOR=
UTTERMOST_SUBMIT_SELECTOR=
# Optional: a button that must be clicked to OPEN the sign-in form (e.g. an
# "account" icon) before the email field appears. Leave blank if not needed.
UTTERMOST_SIGNIN_TRIGGER_SELECTOR=
# Optional: a "load more" button on the overstocks list, clicked until it's gone.
UTTERMOST_LOAD_MORE_SELECTOR=

# ─────────────────────────────────────────────────────────────────────────────
# Remote browser (OPTIONAL, RECOMMENDED for reliability at scale)
# If set, connects to a hosted Chromium (e.g. browserless.io) instead of the
# bundled @sparticuz/chromium. Sidesteps all serverless-chromium size/time limits.
# Example: wss://chrome.browserless.io?token=YOUR_TOKEN
# ─────────────────────────────────────────────────────────────────────────────
BROWSER_WS_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# Cron protection & storage (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────
# Secret required to trigger /api/cron and the write endpoints manually.
# Vercel Cron automatically sends the correct Authorization header when set in
# project env. Also accepted as ?token=... on manual calls.
CRON_SECRET=
# Vercel Blob is auto-configured (BLOB_READ_WRITE_TOKEN) when you connect a Blob
# store to the project. If absent, the cron still runs and returns data inline.

# ─────────────────────────────────────────────────────────────────────────────
# Shopify price update (OPTIONAL — enable when you're ready for step 2)
# ─────────────────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-01
# Multiplier applied to the scraped Uttermost price before writing to Shopify.
# 1 = write the scraped price as-is. 2.2 = 2.2x markup, etc.
PRICE_MARKUP=1
# Safety switch. "true" = only report what WOULD change, write nothing.
SHOPIFY_DRY_RUN=true
