{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/scrape/route.js": { "memory": 2048, "maxDuration": 60 },
    "app/api/csv/route.js": { "memory": 2048, "maxDuration": 60 },
    "app/api/cron/route.js": { "memory": 2048, "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron?source=overstocks", "schedule": "0 9 * * 1" },
    { "path": "/api/cron?source=quarterly", "schedule": "30 9 * * 1" }
  ]
}
